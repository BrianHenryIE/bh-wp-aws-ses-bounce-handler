{
  "name": "brianhenryie/bh-wp-aws-ses-bounce-handler",
  "description": "Unsubscribe users from email lists when AWS SES sends a bounce or complaint report.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0+-or-later",
  "authors": [
    {
      "name": "Brian Henry",
      "email": "BrianHenryIE@gmail.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "brianhenryie/composer-phpstorm": true,
      "composer/installers": true,
      "cweagans/composer-patches": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "johnpbloch/wordpress-core-installer": true,
      "phpstan/extension-installer": true
    },
    "platform": {
      "php": "8.0"
    },
    "process-timeout": 0,
    "sort-packages": true
  },
  "autoload-dev": {
    "psr-4": {
      "BrianHenryIE\\AWS_SES_Bounce_Handler\\": [
        "tests/contract",
        "tests/integration",
        "tests/wpunit",
        "tests/unit"
      ]
    },
    "classmap": [
      "tests/_support"
    ]
  },
  "repositories": {
    "brianhenryie/composer-phpstorm": {
      "url": "https://github.com/BrianHenryIE/composer-phpstorm",
      "type": "git"
    },
    "composer/composer": {
      "type": "composer",
      "url": "https://wpackagist.org"
    },
    "wptrt/admin-notices": {
      "type": "git",
      "url": "https://github.com/brianhenryie/admin-notices"
    },
    "wordpress/wordpress": {
      "url": "https://github.com/WordPress/wordpress-develop",
      "type": "git"
    }
  },
  "require": {
    "php": ">=8.0",
    "ext-json": "*",
    "ext-simplexml": "*",
    "alleyinteractive/wordpress-autoloader": "^1.1",
    "brianhenryie/bh-wp-logger": "*",
    "brianhenryie/bh-wp-private-uploads": "0.2.0 as 0.1.1"
  },
  "require-dev": {
    "10up/wp_mock": "*",
    "antecedent/patchwork": "^2.1",
    "brianhenryie/color-logger": "*",
    "brianhenryie/composer-phpstorm": "dev-master",
    "brianhenryie/php-codecoverage-markdown": "*",
    "brianhenryie/strauss": "*",
    "cweagans/composer-patches": "*",
    "dealerdirect/phpcodesniffer-composer-installer": "*",
    "johnpbloch/wordpress": "*",
    "lucatume/wp-browser": "*",
    "php-stubs/woocommerce-stubs": "*",
    "phpcompatibility/phpcompatibility-wp": "*",
    "phpstan/extension-installer": "*",
    "phpunit/phpcov": "*",
    "rector/rector": "*",
    "squizlabs/php_codesniffer": "*",
    "szepeviktor/phpstan-wordpress": "*",
    "voku/portable-ascii": "dev-master",
    "woocommerce/woocommerce-sniffs": "*",
    "wordpress/wordpress": "*",
    "wp-cli/dist-archive-command": "dev-main",
    "wp-cli/wp-cli-bundle": "*",
    "wp-coding-standards/wpcs": "*  ",
    "wpackagist-plugin/fluent-smtp": ">2.2",
    "wpackagist-plugin/mailpoet": "*",
    "wpackagist-plugin/newsletter": "*",
    "wpackagist-plugin/woocommerce": "*",
    "wpackagist-plugin/wp-mail-logging": ">1.10",
    "wpackagist-plugin/wp-ses": "*",
    "wpackagist-theme/storefront": "*",
    "wpackagist-theme/twentytwenty": "*"
  },
  "extra": {
    "patches": {
      "ericmartel/codeception-email-mailtrap": {
        "Fixed undefined property ": "https://github.com/ericmartel/codeception-email-mailtrap/pull/7.patch"
      }
    },
    "strauss": {
      "namespace_prefix": "BrianHenryIE\\AWS_SES_Bounce_Handler\\",
      "target_directory": "/vendor-prefixed/",
      "classmap_prefix": "BH_WP_AWS_SES_Bounce_Handler_",
      "namespace_replacement_patterns": {
        "~BrianHenryIE\\\\(.*)~" : "BrianHenryIE\\AWS_SES_Bounce_Handler\\\\$1"
      }
    },
    "phpstorm": {
      "exclude_folders": {
        "folders": [
          "vendor/wordpress/wordpress/src",
          "vendor/wordpress/wordpress/build",
          "wordpress/wp-content",
          "wp-content/plugins/bh-wp-aws-ses-bounce-handler",
          "wordpress/wp-content"
        ],
        "include_folders": [
          "vendor/wordpress/wordpress/"
        ]
      }
    }
  },
  "scripts": {
    "post-install-cmd": [
      "vendor/bin/strauss"
    ],
    "post-update-cmd": [
      "vendor/bin/strauss"
    ],
    "test": [
      "vendor/bin/codecept run unit",
      "vendor/bin/codecept run wpunit"
    ],
    "coverage-tests": [
      "vendor/bin/codecept run unit --coverage unit.cov",
      "vendor/bin/codecept run wpunit --coverage wpunit.cov",
      "vendor/bin/phpcov merge --clover tests/_output/clover.xml --html tests/_output/html tests/_output;",
      "open tests/_output/html/index.html"
    ],
    "cs-fix": [
      "phpcbf || true",
      "@cs"
    ],
    "cs": [
      "phpcs || true",
      "phpstan analyse --memory-limit 1G"
    ],
    "cs-strict": [
      "phpcs || true",
      "phpstan analyse --level max --memory-limit 1G"
    ],
    "cs-changes": [
      "updated_files=$(echo $(git diff --name-only `git merge-base origin/master HEAD` | grep \\.php | tr '\\n' '\\0' | xargs -0 ls -1df 2>/dev/null)); if [ -n \"$updated_files\" ]; then phpcbf $(echo $updated_files); phpcs $(echo $updated_files); phpstan analyse $(echo $updated_files) --memory-limit 1G; else echo \"No modified php files for phpstan.\"; fi;"
    ],
    "cs-changes-strict": [
      "updated_files=$(echo $(git diff --name-only `git merge-base origin/master HEAD` | grep \\.php | tr '\\n' '\\0' | xargs -0 ls -1df 2>/dev/null)); if [ -n \"$updated_files\" ]; then phpcbf $(echo $updated_files); phpcs $(echo $updated_files); phpstan analyse $(echo $updated_files) --level max --memory-limit 1G; else echo \"No modified php files for phpstan.\"; fi;"
    ],
    "create-plugin-archive": [
      "vendor/bin/wp i18n make-pot src languages/$(basename \"$PWD\").pot --domain=$(basename \"$PWD\")",
      "vendor/bin/wp dist-archive . ./dist-archive --plugin-dirname=$(basename \"$PWD\") --create-target-dir"
    ],
    "github-actions":  [
      "act -P ubuntu-latest=shivammathur/node:latest"
    ]
  }
}
